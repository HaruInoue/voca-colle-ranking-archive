---
import Base from '@/layouts/Base.astro';
import EventNotices from '@/components/EventNotices.astro';
import {
  publishableEvents,
  publishableDivisions,
  loadEvent,
  loadHourlyIndex,
} from '@/lib/data.js';
import { divisionLabel } from '@/lib/ranking.js';
import { divisionHref } from '@/lib/urls.js';
import { noticesForEventPage } from '@/lib/notices.js';
import { formatAggregationPeriod } from '@/lib/format.js';

export function getStaticPaths() {
  return publishableEvents().map((event) => ({ params: { eventId: event.eventId } }));
}

const { eventId } = Astro.params;
const event = loadEvent(eventId);
const notices = noticesForEventPage(event);

const divisions = publishableDivisions(eventId).map((division) => ({
  division,
  label: divisionLabel(division),
  period: formatAggregationPeriod(loadHourlyIndex(eventId, division)?.aggregationPeriod),
}));
---

<Base
  title={event.title}
  eventId={eventId}
  crumbs={[{ label: event.title }]}
  description={`${event.title}の部門別ランキングアーカイブ。毎時ランキングと最終ランキングを時刻ごとに確認できます。`}
>
  <header class="event-header">
    <h1>{event.title}</h1>
  </header>

  <EventNotices notices={notices} showDivision={true} />

  <h2 class="section-title">部門</h2>
  <ul class="entry-list">
    {
      divisions.map((item) => (
        <li class="entry-card">
          <h3 class="entry-card-title">
            <a href={divisionHref(eventId, item.division)}>
              <span class="division-badge" data-division={item.division} aria-hidden="true" />
              {item.label}部門
            </a>
          </h3>
          <div class="entry-card-body">
            <dl class="division-meta">
              <div>
                <dt>集計期間</dt>
                <dd class="numeric">{item.period}</dd>
              </div>
            </dl>
          </div>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .event-header {
    margin-bottom: var(--space-5);
  }

  .event-header h1 {
    font-size: 1.875rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    color: var(--accent-ink);
  }

  .section-title {
    font-size: 1rem;
    color: var(--muted-text);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }

  .division-meta {
    margin: 0;
    display: grid;
    gap: var(--space-2);
    font-size: 0.8125rem;
  }

  .division-meta dt {
    color: var(--muted-text);
  }

  .division-meta dd {
    margin: 0;
  }
</style>
